# ──────────────────────────────────────────────────
# AI Lead Intelligence — Environment Configuration
# Copy this file to app/.env.local and fill in values
# ──────────────────────────────────────────────────

# ── OpenRouter LLM API ──────────────────────────
# Shared team key — get your own at https://openrouter.ai/keys if this expires
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Primary model — free NVIDIA reasoning model with vision support
# Fallback chain: nemotron:free → google/gemini-2.5-flash → meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ── Call Mode ───────────────────────────────────
# Options: "synthetic" (mock calls, no real phone) | "live" (requires CALL_E_API_KEY)
CALL_MODE=synthetic

# ── CALL-E API (optional) ───────────────────────
# Required only when CALL_MODE=live
# CALL_E_API_KEY=

# ── Apollo.io Discovery (optional) ──────────────
# Required to enable the Apollo.io lead discovery tool + "Apollo AI Leads" flashcard.
# Get a key at https://www.apollo.io/
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Results per page per search request (Apollo max = 25)
APOLLO_PER_PAGE=25
# Max result pages fetched before stopping (25 people per page)
APOLLO_MAX_PAGES=1
APOLLO_TIMEOUT_MS=20000
# Default contact reveal state when no DB setting exists ("true"/"false")
APOLLO_REVEAL_DEFAULT=false

# ── Discovery tool enablement ───────────────────
# Comma-separated list of active discovery tools.
# DISCOVERY_TOOLS=duckduckgo,google-maps,directories,google-search,linkedin,apollo
